# Copy to .env and fill in. .env is gitignored — never commit real values.
# Used by `netlify dev` locally; set the same variables in the Netlify UI for
# production (Site configuration -> Environment variables).
#
# NOTE: none of these use a VITE_ prefix, and that is deliberate. VITE_ variables
# are compiled into the public JavaScript bundle and readable by any visitor.
# Every secret here stays server-side in the Netlify functions.

# ---- Catch reports -> Supabase (preferred; see SETUP-SUPABASE.md) ----
# Run supabase/migrations/0001_catch_reports.sql first.
# Get both from: Project Settings -> Data API.
# SUPABASE_SERVICE_KEY is the service_role key, NOT the anon key — it bypasses
# Row Level Security, so treat it like a database password.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ---- Catch reports -> Google Sheets (fallback; see SETUP-SHEETS.md) ----
# Only used if the SUPABASE_* pair above is absent. Supabase takes priority.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
SHEET_ID=the_long_id_from_your_sheet_url
# Optional, defaults to "reports"
SHEET_TAB=reports

# ---- Weather provider (see SETUP-GOOGLE-WEATHER.md) ----
# Entirely optional. Leave unset and the app uses Open-Meteo (free, no key).
# GOOGLE_MAPS_API_KEY=AIza...
